{
  "name": "@kah/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Knowledge Agent Hub desktop application",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:win": "electron-vite build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.github.kiriukazurei.knowledge-agent-hub",
    "productName": "Knowledge Agent Hub",
    "asar": true,
    "directories": {"output": "../../release"},
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      {"from": "../../services/api/kah-api.exe", "to": "backend/kah-api.exe"},
      {"from": "../../services/worker/dist/kah-worker.exe", "to": "backend/kah-worker.exe"}
    ],
    "win": {"target": ["nsis", "portable"], "signAndEditExecutable": false},
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {"artifactName": "${productName}-${version}-${arch}-portable.${ext}"}
  }
}
